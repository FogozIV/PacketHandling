# Format:
# PacketName PacketEnum (type1 field1) (type2 field2) ...

SendTrajectoryPacket TRAJECTORY (std::vector<double> trajectory) (double acc) (double maxSpeed) (double endSpeed) (double dec) (double maxLateralAcc)
RequestFilePacket FILE_REQUEST (std::string regexExp)
FileResponsePacket FILE_RESPONSE_DATA (std::string filename) (std::vector<uint8_t> data)
DoneSendingFilesPacket FILE_RESPONSE_DONE
DisableControlPacket DISABLE_CONTROL (uint8_t disabled)
ClearTargetPacket CLEAR_TARGET